{
  "name": "loyalflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "deploy:check": "pnpm run db:validate && pnpm run db:migrate:status && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:financial-integrity": "tsx scripts/verify-financial-integrity.ts",
    "reconcile:ledger": "tsx scripts/reconcile-ledger.ts",
    "test:reversal-concurrency": "tsx scripts/verify-reversal-concurrency.ts",
    "verify:local-db": "tsx scripts/verify-local-database.ts",
    "verify:local-promotions": "tsx scripts/verify-local-promotions.ts",
    "verify:local-reward-expiration": "tsx scripts/verify-local-reward-expiration.ts",
    "verify:local-referrals": "tsx scripts/verify-local-referrals.ts",
    "verify:local-staff-permissions": "tsx scripts/verify-local-staff-permissions.ts",
    "verify:local-multi-branch": "tsx scripts/verify-local-multi-branch.ts",
    "verify:local-branch-staff": "tsx scripts/verify-local-multi-branch.ts",
    "verify:local-customer-notes-tags": "tsx scripts/verify-local-customer-notes-tags.ts",
    "verify:local-bulk-customer-operations": "tsx scripts/verify-local-bulk-customer-operations.ts",
    "verify:local-offers": "tsx scripts/verify-local-offers.ts",
    "verify:local-business-profile-foundation": "tsx scripts/verify-local-business-profile-foundation.ts",
    "verify:local-business-deletion": "tsx scripts/verify-local-business-deletion.ts",
    "prepare:final-uat": "tsx scripts/prepare-final-uat-fixtures.ts",
    "cleanup:final-uat": "tsx scripts/prepare-final-uat-fixtures.ts",
    "test:browser-uat": "playwright test --config=playwright.config.ts",
    "create-admin": "tsx scripts/create-super-admin.ts",
    "reset:production-data": "tsx scripts/reset-production-data.ts",
    "sync-sheets": "tsx scripts/sync-google-sheets.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "verify:production": "tsx scripts/verify-production-readiness.ts",
    "release:check": "pnpm run db:validate && pnpm run db:migrate:status && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "verify:f19-db-target": "tsx scripts/verify-f19-migration-target.ts",
    "verify:production-db": "tsx scripts/verify-production-database-target.ts",
    "verify:production-smoke": "tsx scripts/verify-production-smoke.ts",
    "release:production-preflight": "pnpm run verify:production && pnpm run verify:production-db && pnpm run db:migrate:status",
    "verify:operations": "tsx scripts/verify-operational-readiness.ts",
    "verify:release-checkpoint": "tsx scripts/verify-release-checkpoint.ts",
    "release:manifest": "tsx scripts/print-release-manifest.ts",
    "release:final": "tsx scripts/run-final-release-gate.ts",
    "release:final:browser": "tsx scripts/run-final-release-gate.ts --browser",
    "release:final:production-readonly": "pnpm run release:production-preflight && pnpm run verify:production-smoke && pnpm run verify:operations",
    "validate:migrations": "node scripts/validate-migration-manifest.mjs",
    "validate:destructive-migrations": "node scripts/scan-destructive-migrations.mjs",
    "validate:workspace": "node scripts/validate-workspace-boundaries.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@inquirer/prompts": "^8.5.2",
    "@loyalflow/contracts": "workspace:*",
    "@loyalflow/domain": "workspace:*",
    "@loyalflow/i18n": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/queue": "^0.4.0",
    "@vvo/tzdb": "^6.198.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "googleapis": "^173.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.26.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "world-countries": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "type": "module",
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "prisma@7.9.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
