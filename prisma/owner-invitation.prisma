model OwnerInvitation {
  id           String                @id @default(cuid())
  firstName    String
  lastName     String?
  email        String                @unique
  phone        String?               @unique
  businessName String?
  country      String?
  source       OwnerInvitationSource @default(MANAGED)
  tokenHash    String                @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime              @default(now())

  @@index([email, expiresAt, usedAt])
}

enum OwnerInvitationSource {
  MANAGED
  PUBLIC_TRIAL
}
