model SuperAdminMfa {
  userId              String   @id
  secretCiphertext    String
  enrollmentTokenHash String?  @unique
  enrollmentExpiresAt DateTime?
  enabledAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SuperAdminMfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}
