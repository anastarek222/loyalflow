# LoyalFlow production environment template
# Copy values into your hosting provider's secret/environment manager.
# Never commit real secrets.

# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
AUTH_SECRET="replace-with-a-long-random-secret"
# Replace this value with the real deployed HTTPS application origin used by auth/email links.
# Production validation intentionally rejects placeholder domains.
NEXT_PUBLIC_APP_URL="https://replace-with-real-domain.invalid"
# Canonical public marketing/SEO origin used by metadata, robots, and sitemap.
# Keep this separate from Preview/request origins; update it when the final public domain is ready.
NEXT_PUBLIC_SITE_URL="https://loyalflow-gray.vercel.app"

# Optional public support channels shown on the Contact page.
# Use international phone format, for example +201001234567.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# Optional public social profiles shown in the Marketing footer.
# Only validated HTTPS profile URLs for the matching provider are rendered.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# Legal pages remain noindex until every value is valid and publication is approved.
NEXT_PUBLIC_LEGAL_PUBLICATION_STATUS="draft"
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_LEGAL_COUNTRY=""
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=""
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=""

# Required in production for distributed rate limiting.
# Use the server-only Standard REST token from the managed Upstash Redis database.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Prisma development-only shadow database.
# Do not configure this in production unless your hosting workflow explicitly needs it.
SHADOW_DATABASE_URL=""

# Optional: Google Sheets integration.
GOOGLE_SPREADSHEET_ID=""
# Vercel/server-only credentials. GOOGLE_PRIVATE_KEY may use literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional: transactional auth email delivery through Resend.
# Used for password reset, email verification, and owner invitations.
# Keep the API key server-only. The shared sender is governed in source as
# Tanee <noreply@gettanee.com> after verified-domain activation.
RESEND_API_KEY=""

# Custom Card private artwork storage.
# Connect a Vercel Blob store to every environment where Custom Card upload,
# preview, retention, and publishing must work. The runtime accepts either
# managed-storage indicator as evidence that Blob storage is configured.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# WhatsApp Cloud API runtime.
# Per-business phone number IDs/access tokens are stored encrypted in the database.
# These values are server-only and must never use NEXT_PUBLIC_ prefixes.
WHATSAPP_GRAPH_API_VERSION="v22.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Global credentials are legacy/fallback only when a business has no saved connection.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Approved Meta template names. Language codes can be adjusted to match approved templates.
WHATSAPP_TEMPLATE_WELCOME_AR=""
WHATSAPP_TEMPLATE_WELCOME_EN=""
WHATSAPP_TEMPLATE_BALANCE_AR=""
WHATSAPP_TEMPLATE_BALANCE_EN=""
WHATSAPP_TEMPLATE_REWARD_READY_AR=""
WHATSAPP_TEMPLATE_REWARD_READY_EN=""
WHATSAPP_TEMPLATE_REDEEMED_AR=""
WHATSAPP_TEMPLATE_REDEEMED_EN=""
WHATSAPP_TEMPLATE_LANGUAGE_AR="ar"
WHATSAPP_TEMPLATE_LANGUAGE_EN="en_US"

# Production identity and release metadata.
# T007 staging readiness compares normalized endpoint hosts without exposing DATABASE_URL.
# F19 still requires LOYALFLOW_PRODUCTION_DATABASE to match current_database() in production.
LOYALFLOW_ENVIRONMENT="production"
LOYALFLOW_STAGING_DATABASE_HOST=""
LOYALFLOW_PRODUCTION_DATABASE_HOST=""
LOYALFLOW_PRODUCTION_DATABASE="neondb"
LOYALFLOW_RELEASE_SHA=""
